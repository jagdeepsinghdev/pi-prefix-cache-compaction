{
  "name": "pi-prefix-cache-compaction",
  "version": "0.3.0",
  "description": "Pi compaction that reuses the model server's prefix cache (vLLM, SGLang, llama.cpp, or hosted APIs with automatic caching such as DeepSeek; Anthropic Messages and OpenAI Chat Completions): no cold re-prefill of the history, plus a warm-up so the next turn starts from cache.",
  "type": "module",
  "license": "MIT",
  "author": "jagdeep Singh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jagdeepsinghdev/pi-prefix-cache-compaction.git"
  },
  "homepage": "https://github.com/jagdeepsinghdev/pi-prefix-cache-compaction#readme",
  "bugs": {
    "url": "https://github.com/jagdeepsinghdev/pi-prefix-cache-compaction/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "pi-coding-agent",
    "coding-agent",
    "extension",
    "compaction",
    "context-compaction",
    "auto-compact",
    "prefix-cache",
    "prompt-cache",
    "kv-cache",
    "kv-cache-reuse",
    "anthropic-messages",
    "chat-completions",
    "openai-compatible",
    "openai-completions",
    "vllm",
    "sglang",
    "llama.cpp",
    "qwen",
    "local-llm",
    "self-hosted",
    "deepseek",
    "hosted-api"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.85.0",
    "@earendil-works/pi-ai": ">=0.85.0"
  },
  "scripts": {
    "test": "node --test test/core.test.ts",
    "smoke": "node scripts/rpc-smoke.mjs"
  }
}
